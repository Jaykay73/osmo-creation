# Public canonical URL (used for metadata, sitemap and canonical links)
# On Vercel, leave unset to use the project's production URL automatically.
# Set this only when the production domain is confirmed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Enquiry delivery — create an API key at https://resend.com
RESEND_API_KEY=
# The verified sender address in your Resend account, e.g.
# ENQUIRY_FROM_EMAIL=OSMO Creation <enquiries@osmo.com.ng>
ENQUIRY_FROM_EMAIL=
# Where enquiries should arrive. Defaults to salakoolashubomi@gmail.com.
ENQUIRY_TO_EMAIL=salakoolashubomi@gmail.com
